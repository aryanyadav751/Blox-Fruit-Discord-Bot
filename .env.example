# ==========================================
# Blox Fruit Services Discord Bot - Configuration
# ==========================================
# Replace these placeholder values with your real Discord IDs and Token.
# NEVER commit your real .env file or share your bot token!

# 1. Your Discord Bot Token (from Discord Developer Portal -> Bot -> Reset Token)
DISCORD_BOT_TOKEN="YOUR_BOT_TOKEN_HERE"

# 2. Your Discord Server ID (Right-click server icon in Discord -> Copy Server ID)
GUILD_ID="123456789012345678"

# 3. Channel where the public "Order Now" panel will be sent
ORDER_CHANNEL_ID="123456789012345678"

# 4. Channel where order alerts and private staff threads will be created
STAFF_CHANNEL_ID="123456789012345678"

# 5. Role ID for authorized staff members who can accept orders and verify payments
STAFF_ROLE_ID="123456789012345678"

# 6. Optional: Administrator Role ID for full price editing and catalog management
ADMIN_ROLE_ID="123456789012345678"

# 7. Path to the SQLite database file (default is data/blox_fruits.db)
DATABASE_PATH="data/blox_fruits.db"

# 8. Path to the service catalog JSON file
CATALOG_PATH="data/catalog.json"
